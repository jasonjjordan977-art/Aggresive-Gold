{
  "expo": {
    "icon": "./assets/icon.png",
    "android": {
      "package": "com.goldscalper_g8k2.runable",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#090C0D"
      },
      "edgeToEdgeEnabled": true
    },
    "extra": {
      "apiUrl": "https://aggress-fzvpmri-preview-4200.runable.site/",
      "applicationId": "aggress-fzvpmri",
      "runableAuthIssuer": "https://api.runable.com/api/auth"
    },
    "ios": {
      "bundleIdentifier": "com.goldscalper_g8k2.runable",
      "supportsTablet": true
    },
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "cover",
      "backgroundColor": "#090C0D"
    },
    "name": "AGGRESSIVE GOLD SCALPER",
    "slug": "aggressive-gold-scalper",
    "version": "1.0.0",
    "scheme": "runable-aggress-fzvpmri",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font"
    ]
  }
}
